<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup and transfer rules. Everything is excluded from both transports; see the
    <application> comment in AndroidManifest.xml for why SlowLock's state is not portable.

    Excluding the "root" domain covers the app's whole data directory, which is where both
    stores live: LockStore's and DelayConfigStore's SharedPreferences files, and the icon cache.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
