# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}
# ShortcutLaunchActivity's fully-qualified name is written into the persisted intent of every
# pinned shortcut already sitting on a user's home screen (contracts/pinned-shortcut.md), so it
# is FROZEN and R8 must not rename it. ShortcutContractTest already fails the build if the class
# moves in source; this is the same obligation enforced against the shrinker.
-keepnames class com.slowlock.shortcut.ShortcutLaunchActivity
